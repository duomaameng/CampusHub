# Copy this file to deploy/.env before starting the production stack.
# Never commit deploy/.env.

DB_NAME=campus_hub
DB_USERNAME=campushub
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-different-root-password

# Use at least 32 random bytes. Example generator:
# openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-jwt-secret

# "log" is suitable for the course demo. Use "smtp" only after configuring SMTP.
MAIL_DELIVERY_MODE=log
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Change to another host port only when port 80 is already occupied.
HTTP_PORT=80
